# Copy this file to .env.local for local testing.
# Add the same values in Vercel: Project -> Settings -> Environment Variables.

# Clerk (dashboard.clerk.com -> your app -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (supabase.com -> your project -> Project Settings -> API Keys / Data API)
# Use the SECRET key (sb_secret_...) or the legacy service_role key. Never share it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# App settings
NEXT_PUBLIC_APP_NAME=738 Afties
NEXT_PUBLIC_TIMEZONE=America/Los_Angeles
# Sales before this hour count for the night before (party runs past midnight)
NEXT_PUBLIC_BUSINESS_DAY_START_HOUR=11
